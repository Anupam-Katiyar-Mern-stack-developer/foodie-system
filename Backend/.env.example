REDIS_URL=redis://127.0.0.1:6379

GEOAPIFY_API_KEY=""
# Razorpay Standard Checkout. Replace placeholders with real TEST keys first.
# Online payments stay unavailable while these are placeholders.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_WEBHOOK_SECRET
# Dashboard webhook URL: https://YOUR_BACKEND/api/payments/webhook
# Subscribe to payment.captured, payment.authorized and payment.failed.
# Authorized payments are captured by this backend; browser callbacks and a recovery worker verify them.
# Webhooks are optional for basic checkout and recommended for prompt gateway notifications.
