DB_USER=postgres
DB_PASSWORD=""

JWT_SECRET=foodie_super_secret_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=yourmail@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD

MAIL_FROM_NAME=Foodie
